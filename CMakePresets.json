{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_STATIC_LIBRARY": "ON",
        "SPEED_UP_BUILD_UNITY": "ON",
        "OPTIONS_ENABLE_SCCACHE": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "displayName": "Windows - Release",
      "description": "Windows Release Build",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-release-asan",
      "inherits": "windows-release",
      "displayName": "Windows - Release + ASAN",
      "description": "Release Mode with ASAN",
      "cacheVariables": {
        "ASAN_ENABLED": "ON",
        "DEBUG_LOG": "ON",
        "BUILD_STATIC_LIBRARY": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-release",
      "displayName": "Windows - Debug",
      "description": "Build Debug Mode",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEBUG_LOG": "ON",
        "ASAN_ENABLED": "OFF",
        "BUILD_STATIC_LIBRARY": "OFF",
        "SPEED_UP_BUILD_UNITY": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "displayName": "Linux - Release",
      "description": "Sets Ninja generator, compilers, build and install directory and set build type as release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "RUN_TESTS_AFTER_BUILD": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-release",
      "displayName": "Linux - Debug Build",
      "description": "Build Debug Mode",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEBUG_LOG": "ON",
        "SPEED_UP_BUILD_UNITY": "OFF"
      }
    },
    {
      "name": "linux-debug-asan",
      "inherits": "linux-release",
      "displayName": "Linux - Debug Build",
      "description": "Build Debug Mode With ASAN Enable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEBUG_LOG": "ON",
        "ASAN_ENABLED": "ON",
        "SPEED_UP_BUILD_UNITY": "OFF"
      }
    },
    {
      "name": "linux-test",
      "inherits": "linux-release",
      "displayName": "Linux - Test Build",
      "description": "Build Tests",
      "cacheVariables": {
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-release",
      "inherits": "base",
      "displayName": "macOS - Release",
      "description": "macOS Release Build (Apple Silicon or Intel)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "RUN_TESTS_AFTER_BUILD": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "macos-release",
      "displayName": "macOS - Debug Build",
      "description": "Build Debug Mode",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEBUG_LOG": "ON",
        "SPEED_UP_BUILD_UNITY": "OFF"
      }
    },
    {
      "name": "windows-debug-cache",
      "inherits": "windows-debug",
      "displayName": "Windows Debug - compiler cache",
      "description": "Disable PCH so compiler objects can be cached; preserve production optimization and runtime settings",
      "cacheVariables": {
        "USE_PRECOMPILED_HEADER": "OFF",
        "ENABLE_TEST_LTO": "OFF"
      }
    },
    {
      "name": "windows-release-cache",
      "inherits": "windows-release",
      "displayName": "Windows Release - compiler cache",
      "description": "Disable PCH so compiler objects can be cached; preserve production optimization and runtime settings",
      "cacheVariables": {
        "USE_PRECOMPILED_HEADER": "OFF",
        "ENABLE_TEST_LTO": "OFF"
      }
    },
    {
      "name": "linux-debug-cache",
      "inherits": "linux-debug",
      "displayName": "Linux Debug - compiler cache",
      "description": "Disable PCH so compiler objects can be cached; preserve production optimization and runtime settings",
      "cacheVariables": {
        "USE_PRECOMPILED_HEADER": "OFF",
        "OPTIONS_ENABLE_CCACHE": "ON",
        "OPTIONS_ENABLE_SCCACHE": "OFF",
        "ENABLE_TEST_LTO": "OFF"
      }
    },
    {
      "name": "linux-release-cache",
      "inherits": "linux-release",
      "displayName": "Linux Release - compiler cache",
      "description": "Disable PCH so compiler objects can be cached; preserve production optimization and runtime settings",
      "cacheVariables": {
        "USE_PRECOMPILED_HEADER": "OFF",
        "OPTIONS_ENABLE_CCACHE": "ON",
        "OPTIONS_ENABLE_SCCACHE": "OFF",
        "ENABLE_TEST_LTO": "OFF"
      }
    },
    {
      "name": "windows-debug-cache-unity",
      "inherits": "windows-debug-cache",
      "displayName": "Windows Debug - cache and unity candidate",
      "description": "Measured optional candidate; original Debug preset remains unchanged",
      "cacheVariables": {
        "SPEED_UP_BUILD_UNITY": "ON",
        "ENABLE_TEST_LTO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-test",
      "configurePreset": "linux-test"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-release-asan",
      "configurePreset": "windows-release-asan"
    },
    {
      "name": "windows-Xdebug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "windows-debug-cache",
      "configurePreset": "windows-debug-cache"
    },
    {
      "name": "windows-release-cache",
      "configurePreset": "windows-release-cache"
    },
    {
      "name": "linux-debug-cache",
      "configurePreset": "linux-debug-cache"
    },
    {
      "name": "linux-release-cache",
      "configurePreset": "linux-release-cache"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-debug-cache-unity",
      "configurePreset": "windows-debug-cache-unity"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug-cache",
      "configurePreset": "windows-debug-cache",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^unit$"
        }
      }
    },
    {
      "name": "windows-release-cache",
      "configurePreset": "windows-release-cache",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^unit$"
        }
      }
    },
    {
      "name": "linux-debug-cache",
      "configurePreset": "linux-debug-cache",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^unit$"
        }
      }
    },
    {
      "name": "linux-release-cache",
      "configurePreset": "linux-release-cache",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^unit$"
        }
      }
    },
    {
      "name": "windows-debug-cache-unity",
      "configurePreset": "windows-debug-cache-unity",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^unit$"
        }
      }
    }
  ]
}
