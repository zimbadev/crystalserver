Backport of the upstream Boost.Locale fix for the configuration error:

  CMake Error at libs/locale/CMakeLists.txt:236 (source_group):
    source_group ROOT: ".../include/boost/locale" is not a prefix of
    ".../include/boost/locale.hpp"

`source_group(TREE ...)` is called with a root directory that does not
contain the standalone `include/boost/locale.hpp` header. Exclude that
header from the tree listing; the following `source_group("headers" ...)`
line already puts it in the right place.

Upstream: https://github.com/boostorg/boost/issues/1162
Commit: 1d070743d98469809a92c5bb3fca4720bd2bd782

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -232,6 +232,7 @@ set(sources_src ${sources})
 list(FILTER sources_src INCLUDE REGEX "^src/")
 set(sources_inc ${sources})
 list(FILTER sources_inc EXCLUDE REGEX "^src/")
+list(FILTER sources_inc EXCLUDE REGEX "locale\\.hpp$")
 source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}/src" PREFIX "sources" FILES ${sources_src})
 source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}/include/boost/locale" PREFIX "headers" FILES ${sources_inc})
 source_group("headers" FILES "include/boost/locale.hpp")
