<?xml version="1.0" encoding="UTF-8"?>
<!--
	Daily rewards, Winter Update 2026 rules (they apply to every client version):
	- one click claim, every day has a fixed reward (no item picking)
	- rerollTokensPerClaim: Bounty Reroll Tokens every claim gives on top of the reward of the day
	  (the bounty board cap, config bountyTasksMaxRerollTokens, still applies)

	<reward day="1..7" type="..." freeAccount="N" premiumAccount="N" />
	type            freeAccount / premiumAccount
	item            count of every <item> child (itemCharges="N" sets the charges of non stackable items)
	preyReroll      Prey Wildcards
	xpBoost         minutes; the percent is freePercent / premiumPercent (default 50)
	cosmeticTokens  Cosmetic Tokens
	bountyRerollTokens  Bounty Reroll Tokens (in addition to rerollTokensPerClaim)

	The daily XP boost is separate from the Store XP boost: both are added while active and a new
	daily boost replaces what is left of the old one.
-->
<dailyrewards testMode="false" serverTimeThreshold="86400" rerollTokensPerClaim="1">
	<storages>
		<storage name="currentDayStreak" key="14897" />
		<storage name="nextRewardTime" key="14899" />
		<storage name="collectionTokens" key="14901" />
		<storage name="staminaBonus" key="14902" />
		<storage name="jokerTokens" key="14903" />
		<storage name="lastServerSave" key="14110" />
		<storage name="avoidDouble" key="13412" />
		<storage name="notifyReset" key="13413" />
		<storage name="avoidDoubleJoker" key="13414" />
	</storages>

	<!--
		Only shown to 15.30 clients (resting area panel of the reward wall). Since the Winter Update 2026 the
		resting area bonuses no longer depend on the streak: Premium accounts get hit point, mana, stamina and
		soul regeneration with doubled hit point and mana regeneration, free accounts get hit point and mana
		regeneration. The streak now gives a chance (1% per streak day, up to 7%) for double weapon
		proficiency experience.
	-->
	<strikeBonuses>
		<bonus day="1" text="No bonus for first day" />
		<bonus day="2" text="Allow Hit Point Regeneration" />
		<bonus day="3" text="Allow Mana Regeneration" />
		<bonus day="4" text="Stamina Regeneration" />
		<bonus day="5" text="Double Hit Point Regeneration" />
		<bonus day="6" text="Double Mana Regeneration" />
		<bonus day="7" text="Soul Points Regeneration" />
	</strikeBonuses>

	<rewards>
		<reward day="1" type="cosmeticTokens" freeAccount="2" premiumAccount="4" />
		<reward day="2" type="preyReroll" freeAccount="1" premiumAccount="2" />
		<!--
			Day 3 is one temporary temple teleport scroll for free and Premium accounts. Its item id and
			lifetime are not known yet, so no item is configured and the day only gives the Reroll Token.
			Add the item once it is known: <item id="..." /> or <item name="..." />
		-->
		<reward day="3" type="item" freeAccount="1" premiumAccount="1" />
		<reward day="4" type="xpBoost" freeAccount="30" premiumAccount="30" freePercent="10" premiumPercent="25" />
		<reward day="5" type="cosmeticTokens" freeAccount="3" premiumAccount="6" />
		<reward day="6" type="preyReroll" freeAccount="1" premiumAccount="2" />
		<reward day="7" type="xpBoost" freeAccount="30" premiumAccount="30" freePercent="20" premiumPercent="50" />
	</rewards>

	<shrines>
		<item id="25720" />
		<item id="25721" />
		<item id="25722" />
		<item id="25723" />
		<item id="25802" />
		<item id="25803" />
	</shrines>
</dailyrewards>
